{
  "name": "@kaffee/mazagran",
  "version": "2.0.0",
  "description": "Enhance password strength",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "repository": "ice-drip/mazagran",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.js",
      "import": "./dist/esm/types.js",
      "default": "./dist/types.js"
    },
    "./utils/string": {
      "types": "./dist/utils/string.d.ts",
      "require": "./dist/utils/string.js",
      "import": "./dist/esm/utils/string.js",
      "default": "./dist/utils/string.js"
    },
    "./utils/score": {
      "types": "./dist/utils/score.d.ts",
      "require": "./dist/utils/score.js",
      "import": "./dist/esm/utils/score.js",
      "default": "./dist/utils/score.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublish": "pnpm build",
    "ipublish": "npm publish --access public",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "keywords": [
    "password"
  ],
  "author": "Rikka",
  "license": "GPLV3",
  "devDependencies": {
    "@rstest/core": "^0.1.0",
    "@types/node": "22.14.0",
    "tslib": "^2.8.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
